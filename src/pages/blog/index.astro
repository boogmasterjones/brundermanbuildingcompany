---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { site } from '../../lib/site';

const posts = await getPosts();
const jsonLd = [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }])];
const title = "Building & Remodeling Guides | Brunderman Building Co Inc";
const description = "Straight answers to the building and remodeling questions Southwest Florida homeowners ask most, from a builder with four decades of local experience.";
---

<Base title={title} description={description} jsonLd={jsonLd}>
<section class="hero page-hero">
  <div class="container">
    <div>
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Guides</span></nav>
      <span class="eyebrow">Homeowner Guides</span>
      <h1>Building &amp; Remodeling Guides for Southwest Florida Homeowners</h1>
      <p class="hero-lead">Straight answers to the questions we hear most, from a builder with four decades of local experience.</p>
      <div class="hero-actions">
        <a href="tel:+19412760305" onclick="if(typeof gtag==='function')gtag('event','call_click',{'event_category':'engagement','event_label':'guides_hub_hero_phone_button'})" class="btn btn-primary"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg> Call (941) 276-0305</a>
        <a href="#quote" class="btn btn-outline">Request a Quote</a>
      </div>
    </div>
  </div>
</section>
  <section>
    <div class="container">
      <div class="section-head"><span class="eyebrow-dark">Guides</span><h2>Read Before You Build or Remodel</h2></div>
      <div class="card-grid">
      {posts.length === 0 && <p>New articles are coming soon.</p>}
      {posts.map((p) => (
        <a class="card" href={`/blog/${p.id}`}><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="card-link">Read the guide</span></a>
      ))}
      </div>
    </div>
  </section>

</Base>
